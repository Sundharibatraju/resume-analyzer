# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-string-in-production

# JWT
JWT_SECRET_KEY=change-this-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Database
# Leave unset to use the default local SQLite db at backend/instance/resume_analyzer.db
# To override, use an ABSOLUTE sqlite path (sqlite:////absolute/path/to.db) or another DB URL (e.g. Postgres).
DATABASE_URL=

# Uploads
UPLOAD_FOLDER=app/uploads
MAX_CONTENT_LENGTH_MB=10

# CORS
FRONTEND_URL=http://localhost:5173
