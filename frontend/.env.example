# Leave unset for local development — Vite's dev server proxies /api to
# http://localhost:5000 automatically (see vite.config.js).
#
# For production (e.g. deploying to Vercel), set this to your deployed
# backend's URL with NO trailing slash, e.g.:
# VITE_API_URL=https://resume-analyzer-api.onrender.com
VITE_API_URL=
